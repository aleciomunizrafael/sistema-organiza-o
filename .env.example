# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Porta e interface de rede do servidor web
PORT=3000
HOST=0.0.0.0

# Pasta onde ficam o banco (organiza.db) e a sessão do WhatsApp (wa-auth/)
# Faça backup dela. Quem tiver a pasta wa-auth tem acesso ao seu WhatsApp.
DATA_DIR=data

# Fuso horário usado para "hoje", prazos e recorrências
TZ=America/Sao_Paulo

# Senha para proteger a interface (recomendado se outras pessoas acessam a rede).
# Vazio = sem senha. O usuário padrão é "admin" (APP_USER).
APP_PASSWORD=
APP_USER=admin

# Desative para rodar só a lista de tarefas, sem o bot do WhatsApp
WA_ENABLED=true

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
